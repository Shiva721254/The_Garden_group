<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - The_Garden_group</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/The_Garden_group.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm mb-4">
            <div class="container">

                @* Brand link: go to correct dashboard when logged in *@
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    if (User.IsInRole("serviceDesk"))
                    {
                        <a class="navbar-brand fw-bold" href="/ServiceDesk/Dashboard">The_Garden_group</a>
                    }
                    else
                    {
                        <a class="navbar-brand fw-bold" href="/Employee/Dashboard">The_Garden_group</a>
                    }
                }
                else
                {
                    <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">The_Garden_group</a>
                }

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-sm-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>

                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            if (User.IsInRole("employee"))
                            {
                                <li class="nav-item"><a class="nav-link" href="/Employee/Dashboard">Dashboard</a></li>
                                <li class="nav-item"><a class="nav-link" href="/Tickets/Create">Create Ticket</a></li>
                                <li class="nav-item"><a class="nav-link" href="/Tickets/MyTickets">My Tickets</a></li>
                            }

                            if (User.IsInRole("serviceDesk"))
                            {
                                <li class="nav-item"><a class="nav-link" href="/ServiceDesk/Dashboard">Dashboard</a></li>
                                <li class="nav-item"><a class="nav-link" href="/Tickets">Tickets</a></li>
                                <li class="nav-item"><a class="nav-link" href="/Employees">Employees</a></li>
                            }
                        }
                    </ul>

                    @{
                        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
                        var isAuthPage = string.Equals(controller, "Auth", StringComparison.OrdinalIgnoreCase);
                    }

                    @if ((User.Identity?.IsAuthenticated ?? false) && !isAuthPage)
                    {
                        var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
                        var roleLabel = role switch
                        {
                            "serviceDesk" => "Service Desk",
                            "employee" => "Employee",
                            _ => role
                        };

                        <span class="navbar-text me-3">
                            <span class="text-muted">Logged in as</span>
                            <strong>@roleLabel</strong>
                        </span>

                        <form action="/Auth/Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm">Logout</button>
                        </form>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - The_Garden_group 11 - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>