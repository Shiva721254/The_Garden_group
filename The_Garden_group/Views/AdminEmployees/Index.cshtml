@model List<The_Garden_Group.Models.Employee>

<h2>Manage Employees</h2>

<p><a class="btn btn-primary" href="/AdminEmployees/Create">Create Employee</a></p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Active</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.FirstName @e.LastName</td>
                <td>@e.Email</td>
                <td>@e.Role</td>
                <td>@e.IsActive</td>
                <td>
                    <a class="btn btn-sm btn-primary" href="/AdminEmployees/Edit/@e.Id">Edit</a>

                    <form method="post" action="/AdminEmployees/Delete/@e.Id" style="display:inline;">
                        <button class="btn btn-sm btn-danger" type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>