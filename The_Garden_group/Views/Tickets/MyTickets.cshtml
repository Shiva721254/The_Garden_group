@model List<The_Garden_Group.Models.Ticket>

<h2>My Tickets</h2>

<p>
    <a class="btn btn-primary" href="/Tickets/Create">Create new ticket</a>
    <a class="btn btn-secondary" href="/Employee/Dashboard">Back to Dashboard</a>
</p>

@if (Model == null || Model.Count == 0)
{
    <p>No tickets found yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Subject</th>
                <th>Status</th>
                <th>Priority</th>
                <th>Category</th>
                <th>Created</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.Subject</td>
                    <td>@t.Status</td>
                    <td>@t.Priority</td>
                    <td>@t.Category</td>
                    <td>@t.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}