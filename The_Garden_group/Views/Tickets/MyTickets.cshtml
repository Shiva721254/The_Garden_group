@model List<The_Garden_Group.Models.Ticket>
@{
    ViewData["Title"] = "My Tickets";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 fw-bold mb-0">My Tickets</h1>
        <div class="text-muted">Your submitted issues</div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-primary" href="/Tickets/Create">Create new ticket</a>
        <a class="btn btn-outline-secondary" href="/Employee/Dashboard">Back to Dashboard</a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        @if (Model == null || Model.Count == 0)
        {
            <p class="mb-0 text-muted">You have not created any tickets yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Subject</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Category</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@t.Subject</td>
                                <td>
                                    <span class="badge
                                            @(t.Status == "open" ? "bg-warning text-dark" :
                                                                                t.Status == "resolved" ? "bg-success" :
                                                                                "bg-secondary")">
                                        @t.Status
                                    </span>
                                </td>
                                <td class="text-muted">@t.Priority</td>
                                <td class="text-muted">@t.Category</td>
                                <td class="text-muted">@t.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>