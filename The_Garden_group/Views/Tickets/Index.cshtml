@model List<The_Garden_Group.Models.Ticket>
@{
    ViewData["Title"] = "All Tickets";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 fw-bold mb-0">All Tickets</h1>
        <div class="text-muted">Service Desk view</div>
    </div>
    <a class="btn btn-outline-secondary" href="/ServiceDesk/Dashboard">Back to Dashboard</a>
</div>

<form method="get" action="/Tickets" class="row g-2 mb-3">
    <div class="col-12 col-md-6">
        <input class="form-control" name="query" value="@ViewBag.Query" placeholder="Search: wifi printer vpn..." />
    </div>

    <div class="col-6 col-md-2">
        <select class="form-select" name="mode">
            <option value="OR" selected="@(ViewBag.Mode == "OR")">OR</option>
            <option value="AND" selected="@(ViewBag.Mode == "AND")">AND</option>
        </select>
    </div>

    <div class="col-6 col-md-2">
        <button class="btn btn-primary w-100" type="submit">Search</button>
    </div>

    <div class="col-12 col-md-2">
        <a class="btn btn-outline-secondary w-100" href="/Tickets">Reset</a>
    </div>
</form>

<div class="card shadow-sm border-0">
    <div class="card-body">
        @if (Model == null || Model.Count == 0)
        {
            <p class="mb-0 text-muted">No tickets found.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Subject</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Category</th>
                            <th>Created</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@t.Subject</td>
                                <td>
                                    <span class="badge
                                            @(t.Status == "open" ? "bg-warning text-dark" :
                                                                                t.Status == "resolved" ? "bg-success" :
                                                                                "bg-secondary")">
                                        @t.Status
                                    </span>
                                </td>
                                <td>
                                    <span class="badge
                                            @(t.Priority == "high" ? "bg-danger" :
                                                                                t.Priority == "medium" ? "bg-primary" :
                                                                                "bg-info text-dark")">
                                        @t.Priority
                                    </span>
                                </td>
                                <td class="text-muted">@t.Category</td>
                                <td class="text-muted">@t.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-primary" href="/Tickets/Edit/@t.Id">Edit</a>
                                    <form method="post" action="/Tickets/Delete/@t.Id" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-danger" type="submit"
                                                onclick="return confirm('Delete this ticket?');">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>