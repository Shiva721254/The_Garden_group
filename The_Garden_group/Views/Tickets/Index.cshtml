@model List<The_Garden_Group.Models.Ticket>

<h2>All Tickets (Service Desk)</h2>

<table class="table">
    <thead>
        <tr>
            <th>Subject</th>
            <th>Status</th>
            <th>Priority</th>
            <th>Category</th>
            <th>Created</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@t.Subject</td>
                <td>
                    <span class="badge
            @(t.Status == "open" ? "bg-warning text-dark" :
                                    t.Status == "resolved" ? "bg-success" :
                                    "bg-secondary")">
                        @t.Status
                    </span>
                </td>
                <td>@t.Priority</td>
                <td>@t.Category</td>
                <td>@t.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    <a class="btn btn-sm btn-primary" href="/Tickets/Edit/@t.Id">Edit</a>
                    <form method="post" action="/Tickets/Delete/@t.Id" style="display:inline;">
                        <button class="btn btn-sm btn-danger" type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>