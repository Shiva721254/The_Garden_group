@model The_Garden_Group.ViewModels.DashboardVm
@{
    ViewData["Title"] = "My Dashboard";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 fw-bold mb-0">My Dashboard</h1>
        <div class="text-muted">Overview of your tickets</div>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-primary" href="/Tickets/Create">Create Ticket</a>
        <a class="btn btn-outline-secondary" href="/Tickets/MyTickets">My Tickets</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small">Total</div>
                <div class="h3 fw-bold mb-0">@Model.Total</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small">Open</div>
                <div class="h3 fw-bold mb-0">@Model.Open</div>
                <div class="text-muted small">@Model.OpenPct.ToString("0.0")%</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small">Resolved</div>
                <div class="h3 fw-bold mb-0">@Model.Resolved</div>
                <div class="text-muted small">@Model.ResolvedPct.ToString("0.0")%</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small">Closed</div>
                <div class="h3 fw-bold mb-0">@Model.Closed</div>
                <div class="text-muted small">@Model.ClosedPct.ToString("0.0")%</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <h2 class="h6 fw-bold mb-2">How to use</h2>
        <ul class="mb-0 text-muted">
            <li>Create a ticket when you have an issue.</li>
            <li>Track progress under <strong>My Tickets</strong>.</li>
            <li>Status updates are done by Service Desk.</li>
        </ul>
    </div>
</div>