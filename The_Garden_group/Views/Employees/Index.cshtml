@model List<The_Garden_Group.Models.Employee>
@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="h3 fw-bold mb-0">Employees</h1>
        <div class="text-muted">Manage user accounts</div>
    </div>
    <a class="btn btn-primary" href="/Employees/Create">Create Employee</a>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Active</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td>@e.FirstName @e.LastName</td>
                        <td>@e.Email</td>
                        <td>@e.Role</td>
                        <td>@(e.IsActive ? "Yes" : "No")</td>
                        <td>@e.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-secondary" href="/Employees/Edit/@e.Id">Edit</a>
                            <a class="btn btn-sm btn-danger" href="/Employees/Delete/@e.Id">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>